    "nvidia": {
      "models": {
        "stepfun-ai/step-3.5-flash": {
          "name": "Step-3.5 Flash"
        }
      },
      "name": "Nvidia",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1"
      }
    },
    "ollama": {
      "models": {
        "kimi-k2.5:cloud": {
          "_launch": true,
          "limit": {
            "context": 262144,
            "output": 262144
          },
          "name": "kimi-k2.5:cloud"
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
